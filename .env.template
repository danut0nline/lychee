# Copy this file to .env.local. Do not put real credentials in this template.

# Local development defaults to file:./lychee.db when this is omitted.
TURSO_DATABASE_URL=file:./lychee.db
# Required when using a remote Turso database.
TURSO_AUTH_TOKEN=

LICHESS_CLIENT_ID=
# Set in production to the deployed origin, for example https://example.com.
NEXT_PUBLIC_BASE_URL=

# Optional: redirect every request when set.
REDIRECT=

# One-time MongoDB import only. Do not use these for normal app runtime.
SOURCE_MONGODB_URI=
SOURCE_MONGODB_DATABASE=
